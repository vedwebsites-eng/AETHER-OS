{
  "entities": {
    "GlobalClock": {
      "title": "Global Clock",
      "description": "System-wide clock settings and last reset timestamp",
      "type": "object",
      "properties": {
        "lastResetAt": { "type": "string", "format": "date-time" },
        "resetTime": { "type": "string", "description": "Format HH:mm" },
        "timezone": { "type": "string" }
      },
      "required": ["lastResetAt", "resetTime", "timezone"]
    }
  },
  "firestore": {
    "/system_settings/global_clock": {
      "schema": "GlobalClock",
      "description": "Singleton document for system clock"
    }
  }
}
